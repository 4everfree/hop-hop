# --- Python (python/) ---------------------------------------------------
# Packaging patterns are scoped to python/ so they don't swallow C++ sources
# (a plain `lib/` or `build/` would hide cpp/lib, cpp/build source trees).
__pycache__/
*.py[cod]
*$py.class
python/build/
python/dist/
python/sdist/
python/wheels/
python/*.egg-info/
python/.eggs/
*.egg
MANIFEST

# Environments
.env
.venv
env/
venv/
ENV/

# Tests / coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.tox/
.nox/
.hypothesis/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# --- C++ / CMake (cpp/) -------------------------------------------------
cpp/build/
cpp/out/
cmake-build-*/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
compile_commands.json
.cache/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
vcpkg_installed/

# --- IDEs / editors -----------------------------------------------------
.idea/
.vscode/
*.swp
*~

# --- OS -----------------------------------------------------------------
.DS_Store
Thumbs.db
